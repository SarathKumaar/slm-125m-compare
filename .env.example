# Copy to .env.local for local dev, and set the same three variables in Vercel
# (Project Settings -> Environment Variables).

# The deployed 125M Modal endpoint base URL (no trailing slash).
MODAL_ENDPOINT=https://sarathkumaar569--slm-125m-serve-chatserver-web.modal.run

# The deployed Gemma-2B Modal endpoint base URL (GPU, no trailing slash).
MODAL_GEMMA_ENDPOINT=https://sarathkumaar569--slm-gemma-serve-gemmaserver-web.modal.run

# Shared secret that matches the Modal `slm-app-secret` (SLM_API_KEY). Server-side only.
SLM_API_KEY=replace-with-the-key
